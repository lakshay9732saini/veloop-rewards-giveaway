# VELOOP Rewards Backend – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veloop-rewards

# JWT signing secret (use a long, random string in production)
JWT_SECRET=change_this_to_a_strong_secret_in_production

# Refresh token secret (if using refresh tokens)
REFRESH_SECRET=change_this_to_another_strong_secret

# Frontend URL for CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# Node environment
NODE_ENV=development
